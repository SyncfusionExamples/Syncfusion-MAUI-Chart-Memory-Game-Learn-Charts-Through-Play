    <ContentPage.BindingContext>
        <local:GameViewModel x:Name="viewModel"/>
    </ContentPage.BindingContext>

    <Grid ColumnDefinitions="4*,6*" RowDefinitions="1*,7.5*,1.5*">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5C86D5" Offset="0"/>
                <GradientStop Color="#7094E1" Offset="0.55"/>
                <GradientStop Color="#9DCCE0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="7*,3*" ColumnSpacing="10">

            <HorizontalStackLayout>
                <Path Data="{StaticResource PathData1}" Fill="White" Margin="5,30,-5,0"
  HeightRequest="50"  WidthRequest="50" VerticalOptions="Center"/>

                <Label Text="CHART MEMORY GAME" TextColor="#EBFFFFFF" VerticalOptions="Center"
FontAttributes="Bold" FontSize="22"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Margin="15,15,0,15" Spacing="3">
                <Button x:Name="infoButton" Command="{Binding InfoCommand}" CommandParameter="{x:Reference infoButton}" Text="&#xe78c;" FontSize="30" FontFamily="MauiSampleFontIcon" 
                    Background="#29FFFFFF" TextColor="White" HeightRequest="10" WidthRequest="10" Padding="6"/>

                <Button Text="&#xe7a2;" FontFamily="MauiMaterialAssets" FontSize="22" Command="{Binding ResetCommand}" CommandParameter="{x:Reference PointSelection}"
                    Background="#29FFFFFF" TextColor="White" HeightRequest="10" WidthRequest="10" Padding="6"/>

                <Border VerticalOptions="Center" Stroke="Transparent" StrokeShape="RoundRectangle 10" HeightRequest="50">
                    <Label BackgroundColor="#29FFFFFF"  Text="{Binding Score, StringFormat='Score: {0}'}" TextColor="White" FontAttributes="Bold"
                            Padding="10" FontSize="17" VerticalTextAlignment="Center"/>
                </Border>
            </HorizontalStackLayout>

        </Grid>

        <Border Grid.Row="1" Grid.Column="0" StrokeThickness="0" Padding="16"  Margin="5,10,5,0" StrokeShape="RoundRectangle 28">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#29FFFFFF" Offset="1.0"/>
                    <GradientStop Color="#1AFFFFFF" Offset="0.75"/>
                    <GradientStop Color="#14000000" Offset="0.45"/>
                    <GradientStop Color="#26000000" Offset="0.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Round, StringFormat='Round: {0}'}" FontAttributes="Bold" FontSize="22" TextColor="#f1f5fb"/>
                <Label Text="{Binding AttemptStatus}" FontSize="18" TextColor="#e3eaf6"/>
                <Label Text="{Binding SequenceText}" x:Name="sequence" FontSize="18" TextColor="#e3eaf6"
                        IsVisible="{Binding ShowSequenceText}"/>

                <ProgressBar Progress="{Binding TimerProgress}" HeightRequest="15" Margin="0,10,0,0" BackgroundColor="#516fbf" 
                            ProgressColor="#e3eaf6"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">

                    <Border Grid.Column="0" StrokeShape="RoundRectangle 24" Stroke="{Binding StartButtonStroke}" 
                            StrokeThickness="3" Padding="0">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#33FFFFFF" Offset="0"/>
                                <GradientStop Color="#14FFFFFF" Offset="0.6"/>
                                <GradientStop Color="#08FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Button Text="Start" TextColor="#FFFFFF" BackgroundColor="#20FFFFFF" FontAttributes="Bold"
                                Padding="18,12" CornerRadius="24" IsEnabled="{Binding StartEnabled}" CommandParameter="{x:Reference PointSelection}" Command="{Binding StartCommand}"/>

                    </Border>

                    <Border Grid.Column="1" Stroke="{Binding ResumeButtonStroke}" StrokeThickness="3"
                            StrokeShape="RoundRectangle 24">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#33FFFFFF" Offset="0"/>
                                <GradientStop Color="#14FFFFFF" Offset="0.6"/>
                                <GradientStop Color="#08FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Button Text="{Binding PauseButtonText}" TextColor="#EFFFFF" BackgroundColor="#20FFFFFF" FontAttributes="Bold"
                                Padding="18,12" CornerRadius="24" Command="{Binding PauseCommand}"/>
                    </Border>

                </Grid>

                <Label Text="{Binding AttemptsDots}" TextColor="#f1f5fb"/>
            </VerticalStackLayout>
        </Border>


        <Border  Grid.Row="1" Grid.Column="1" Padding="16" Background="#ffffff" Margin="5,10,5,0" StrokeShape="RoundRectangle 22">

            <Border.Shadow>
                <Shadow Brush="#efefef" Radius="18" Offset="0,8" Opacity="0.3"/>
            </Border.Shadow>

            <chart:SfCartesianChart>

                <chart:SfCartesianChart.XAxes>
                    <chart:CategoryAxis LabelPlacement="BetweenTicks" ShowMajorGridLines="False">
                        <chart:CategoryAxis.AxisLineStyle>
                            <chart:ChartLineStyle StrokeWidth="0" Stroke="Transparent"/>
                        </chart:CategoryAxis.AxisLineStyle>

                        <chart:CategoryAxis.MajorTickStyle>
                            <chart:ChartAxisTickStyle StrokeWidth="0" Stroke="Transparent"/>
                        </chart:CategoryAxis.MajorTickStyle>

                        <chart:CategoryAxis.LabelStyle>
                            <chart:ChartAxisLabelStyle TextColor="#8C9096" FontSize="18" FontAttributes="Bold,Italic"/>
                        </chart:CategoryAxis.LabelStyle>
                    </chart:CategoryAxis>
                </chart:SfCartesianChart.XAxes>

                <chart:SfCartesianChart.YAxes>
                    <chart:NumericalAxis Minimum="0" Maximum="10" Interval="2" ShowMajorGridLines="False" IsVisible="False"/>
                </chart:SfCartesianChart.YAxes>

                <chart:ColumnSeries x:Name="Series" ItemsSource="{Binding ChartData}" XBindingPath="Category"
                            YBindingPath="Value" CornerRadius="20,20,0,0" PaletteBrushes="{Binding PaletteBrushes}">

                    <chart:ColumnSeries.SelectionBehavior>
                        <chart:DataPointSelectionBehavior x:Name="PointSelection" Type="Single" 
                                 SelectionChanging="OnPointSelectionChanging" SelectionChanged="OnPointSelectionChanged"/>
                    </chart:ColumnSeries.SelectionBehavior>
                </chart:ColumnSeries>

            </chart:SfCartesianChart>

        </Border>

        <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" HorizontalOptions="Center" IsVisible="{Binding WinVisible}" Margin="0,10,0,0" >
            <Path Data="{StaticResource PathData2}"  Fill="#065f3c" HeightRequest="40"  WidthRequest="40" VerticalOptions="Center" />
            <Label  Text="You win...!" FontSize="22" FontAttributes="Bold"  TextColor="#065f3c" />
        </HorizontalStackLayout>

    </Grid>

</ContentPage>